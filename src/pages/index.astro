---
import { getCollection } from 'astro:content';

const work = await getCollection('work');
const tags = [...new Set(work.flatMap((item) => item.data.tags))].sort((a, b) => a.localeCompare(b));
const currentDomains = [...new Set(work
  .filter((item) => item.data.type === 'experience' && /\b(now|present|current)\b/i.test(item.data.date))
  .flatMap((item) => item.data.tags))];
const base = import.meta.env.BASE_URL;
const total = String(work.length).padStart(2, '0');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#b7470d" />
    <meta name="description" content="A thoughtful portfolio of selected work, experience, and skills." />
    <title>Your Name — Portfolio</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:wght@600;700&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400;1,500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <div class="portfolio-layout" id="top">
      <div class="profile-shell" id="about">
        <div class="profile-panel" aria-hidden="true">
          <span class="profile-orbit orbit-one"></span><span class="profile-orbit orbit-two"></span>
        </div>
        <aside class="profile-intro" aria-label="About Your Name">
          <p class="profile-kicker">DEVELOPER</p>
          <h1>Your<br />Name<span class="period">.</span></h1>
          <p class="profile-lede">I build digital things with care, curiosity, and a healthy respect for the details.</p>
          <a class="profile-cta" href="mailto:hello@example.com">LET’S TALK <span aria-hidden="true">↗</span></a>
          <section class="profile-domains" aria-labelledby="profile-domains-title">
            <h2 id="profile-domains-title">DOMAINS</h2>
            <div class="profile-domain-list">
              <a class="profile-domain" href="#work" style={`--domain-image: url('https://images.unsplash.com/photo-1485827404703-89b55fcc595e?auto=format&fit=crop&w=420&q=80')`}><span>Robotics</span></a>
              <a class="profile-domain" href="#work" style={`--domain-image: url('https://images.unsplash.com/photo-1511919884226-fd3cad34687c?auto=format&fit=crop&w=420&q=80')`}><span>Autonomous<br />driving</span></a>
              <a class="profile-domain" href="#work" style={`--domain-image: url('https://images.unsplash.com/photo-1518770660439-4636190af475?auto=format&fit=crop&w=420&q=80')`}><span>Computer<br />science</span></a>
            </div>
          </section>
        </aside>
        <figure class="seam-portrait"><img src={`${base}media/portrait-personal.png`} alt="Portrait of the portfolio owner, looking to the right." /></figure>
      </div>

      <div class="work-panel">
        <main>
          <section class="work-content" id="work" aria-labelledby="work-title">
            {currentDomains.length > 0 && <section class="current-domains" aria-labelledby="domains-title">
              <div class="current-domains-heading"><h2 id="domains-title">What I’m <em>working on.</em></h2></div>
              <div class="domain-bubbles" role="group" aria-label="Filter work by what I’m working on">
                {currentDomains.map((domain) => <button class="domain-bubble" type="button" data-filter={domain} aria-pressed="false" aria-label={`Show ${domain} work`}><strong>{domain}</strong></button>)}
              </div>
            </section>}
            <div class="canvas-heading" id="selected-work"><h2 id="work-title">Noteworthy <em>accomplishments.</em></h2></div>
            <div class="filter-area">
              <div class="filter-label"><span>FIND YOUR WAY THROUGH</span><span class="filter-hint">Filter by a connecting thread</span></div>
              <div class="filters" role="group" aria-label="Filter work by tag">
                <button class="filter-chip active" data-filter="all" aria-pressed="true">Everything <span>{total}</span></button>
                {tags.map((tag) => <button class="filter-chip" data-filter={tag} aria-pressed="false">{tag} <span>{String(work.filter((item) => item.data.tags.includes(tag)).length).padStart(2, '0')}</span></button>)}
              </div>
              <div class="filter-tools">
                <div class="type-filters" role="group" aria-label="Filter by work type"><button class="type-button active" data-type="all">ALL</button><button class="type-button" data-type="experience">EXPERIENCE</button><button class="type-button" data-type="project">PROJECTS</button></div>
                <label class="search-wrap"><span aria-hidden="true">⌕</span><input id="work-search" type="search" placeholder="Search the orbit" aria-label="Search work" /></label>
              </div>
            </div>
            <div class="results-line"><span id="results-label">Showing everything</span><span>{total} ITEMS</span></div>
            <div class="bubble-field" id="work-grid">
              {work.map((item) => <a class="work-card bubble" href={`${base}projects/${item.id.replace(/\.mdx?$/, '')}/`} data-type={item.data.type} data-tags={item.data.tags.join(',')} title={item.data.summary} aria-label={`${item.data.title}, ${item.data.type}, ${item.data.date}`}><span class="bubble-top">{item.data.type === 'project' ? 'PROJECT' : 'ROLE'} · {item.data.date}</span><span class="bubble-content"><strong>{item.data.title}</strong><span class="item-org">{item.data.organization}</span></span><span class="bubble-tags">{item.data.tags.slice(0, 2).map((tag) => <span class="tag">{tag}</span>)}</span></a>)}
            </div>
            <p class="empty-state" id="empty-state" hidden>No work found in this orbit. Try a different tag or search.</p>
            <div class="canvas-footer"><span>THERE’S MORE TO THE STORY</span><a href="mailto:hello@example.com">GET IN TOUCH <span aria-hidden="true">↗</span></a></div>
          </section>
        </main>
      </div>
    </div>
    <script type="module" src={`${base}script.js`}></script>
  </body>
</html>
