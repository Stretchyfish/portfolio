---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('work')).map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, tags, cover } = entry.data;
const visibleTags = tags.filter((tag) => !['accomplishment', 'working-on'].includes(tag.trim().toLowerCase()));
const description = entry.body.split(/\n\s*\n/).map((part) => part.trim()).find((part) => part && !part.startsWith('#')) ?? title;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} — Mikkel Skov Maarssø</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400;1,500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <div class="page-shell project-page">
      <header class="site-header"><a class="wordmark" href={base} aria-label="Mikkel Skov Maarssø, home"><span class="wordmark-mark">MS</span><span>MIKKEL SKOV MAARSSØ</span></a><nav class="main-nav" aria-label="Main navigation"><a href={`${base}#work`}>Work &amp; projects</a><a href={`${base}#about`}>About</a></nav><a class="contact-link" href="mailto:hello@example.com">Let’s talk <span aria-hidden="true">↗</span></a></header>
      <main class="project-detail">
        <a class="text-link back-link" href={`${base}#work`}><span aria-hidden="true">←</span> Back to all work</a>
        <h1>{title}</h1>
        {cover && <img class="project-cover" src={`${base}${cover.replace(/^\/+/, '')}`} alt={`Cover for ${title}`} />}
        <div class="tag-list project-tags">{visibleTags.map((tag) => <span class="tag">{tag}</span>)}</div>
        <article class="markdown-content"><Content /></article>
      </main>
      <footer class="site-footer"><a class="wordmark" href={base}><span class="wordmark-mark">MS</span><span>MIKKEL SKOV MAARSSØ</span></a><span>Thoughtfully made. Last updated 2026.</span><a href="mailto:hello@example.com">SAY HELLO ↗</a></footer>
    </div>
  </body>
</html>
