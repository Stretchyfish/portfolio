---
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  return (await getCollection('work')).map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, '') },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, type, date, organization, summary, tags, link } = entry.data;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={summary} />
    <title>{title} — Your Name</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400;1,500&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href={`${base}styles.css`} />
  </head>
  <body>
    <div class="page-shell project-page">
      <header class="site-header"><a class="wordmark" href={base} aria-label="Your Name, home"><span class="wordmark-mark">YN</span><span>YOUR NAME</span></a><nav class="main-nav" aria-label="Main navigation"><a href={`${base}#work`}>Work &amp; projects</a><a href={`${base}#about`}>About</a></nav><a class="contact-link" href="mailto:hello@example.com">Let’s talk <span aria-hidden="true">↗</span></a></header>
      <main class="project-detail">
        <a class="text-link back-link" href={`${base}#work`}><span aria-hidden="true">←</span> Back to all work</a>
        <p class="eyebrow">{type.toUpperCase()} · {date}</p>
        <p class="item-org">{organization}</p>
        <h1>{title}</h1>
        <p class="project-summary">{summary}</p>
        <div class="tag-list project-tags">{tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        {link && <a class="text-link" href={link} target="_blank" rel="noreferrer">View project <span aria-hidden="true">↗</span></a>}
        <article class="markdown-content"><Content /></article>
      </main>
      <footer class="site-footer"><a class="wordmark" href={base}><span class="wordmark-mark">YN</span><span>YOUR NAME</span></a><span>Thoughtfully made. Last updated 2026.</span><a href="mailto:hello@example.com">SAY HELLO ↗</a></footer>
    </div>
  </body>
</html>
